[Desktop Entry]
Type=Application
Name=Qylyn (麒麟)
Comment=Connect to your shared Qylyn conversations and notes
Exec=qylyn-client
Icon=kylin-client
Terminal=false
StartupWMClass=kylin-client
Categories=Network;
Actions=Configure;

[Desktop Action Configure]
Name=Connection settings
Exec=qylyn-client --configure
