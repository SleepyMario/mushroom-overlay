Backport the current upstream logic so Qt 6.9 and newer do not
incorrectly require the private GUI target during out-of-tree builds.
Explicitly find GuiPrivate when an older Qt 6 release does require it.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -28,3 +28,4 @@
 find_package(Qt6 COMPONENTS Widgets Core)
 target_link_libraries(${PROJECT_NAME} PRIVATE Qt6::Core Qt6::Widgets)
-if((OS_LINUX OR OS_FREEBSD OR OS_OPENBSD) AND Qt_VERSION VERSION_LESS "6.9.0")
+if((OS_LINUX OR OS_FREEBSD OR OS_OPENBSD) AND Qt6_VERSION VERSION_LESS "6.9.0")
+  find_package(Qt6 COMPONENTS GuiPrivate)
