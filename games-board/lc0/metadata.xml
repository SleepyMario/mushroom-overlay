<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "https://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
  <maintainer type="person">
    <email>tech@sleepymario.com</email>
    <name>Sleepy Mario</name>
  </maintainer>
  <longdescription>
    Leela Chess Zero is a neural-network chess engine with GPU and CPU backends.
    Enable networks to install a pinned pre-trained neural network.
  </longdescription>
  <use>
    <flag name="cudnn">Enable the NVIDIA cuDNN backend</flag>
    <flag name="dnnl">Use oneDNN for the BLAS backend</flag>
    <flag name="ispc">Enable ISPC optimized kernels</flag>
    <flag name="networks">Install pinned BT4 weights and, with OpenCL, compatible T70 weights</flag>
    <flag name="openblas">Enable OpenBLAS support</flag>
  </use>
  <upstream>
    <remote-id type="github">LeelaChessZero/lc0</remote-id>
    <bugs-to>https://github.com/LeelaChessZero/lc0/issues</bugs-to>
  </upstream>
</pkgmetadata>
